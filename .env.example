# Copy to .env.local and fill in. NEVER put real keys in this file - it is committed to git.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SERVER ONLY
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Project Settings > JWT Keys > Legacy JWT Secret. Signs session cookies. SERVER ONLY.
SUPABASE_JWT_SECRET=your-legacy-jwt-secret

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sentry (optional)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Email notifications (optional; choose provider in Settings)
RESEND_API_KEY=
EMAIL_FROM="Document Portal <noreply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
